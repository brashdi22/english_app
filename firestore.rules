rules_version = '2';

// Who can see and change what:
//
// users/{uid}                        a child's or a parent's account
// users/{kidUid}/progress/{id}       a child's saved work
//   - only the child can write it; the child and the parent of the family
//     the child has joined (accepted member) can read it.
//   - a child cannot leave a family: while they are a member, their
//     familyCode cannot change. Only the parent removes them.
//   - users/{kidUid}/usage/{day}: screen time used and extra minutes given.
//   - only the parent can delete a member's account; deleted/{kidUid} then
//     stops the login from making a new account (the child's device deletes
//     the login the next time it is used).
//
// families/{code}                    a family (code = the family ID children type)
//   - any signed-in account can look a family up (to send a join request);
//     only its parent can change it.
// families/{code}/private/{doc}      the parent password hash: parent and members only
// families/{code}/requests/{kidUid}  join requests: the child creates one, the parent
//                                    accepts or rejects it
// families/{code}/members/{kidUid}   accepted children, with the summary used by
//                                    the scoreboard: the family can read them; only
//                                    the parent can add a member (from a request)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function family(code) {
      return get(/databases/$(database)/documents/families/$(code));
    }

    function isFamilyParent(code) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(code))
        && family(code).data.parentUid == request.auth.uid;
    }

    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(code)/members/$(request.auth.uid));
    }

    // The signed-in parent's family has this child as an accepted member.
    function isParentOf(kidUid) {
      let parent = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return parent.data.role == 'parent'
        && parent.data.familyCode is string
        && isFamilyParent(parent.data.familyCode)
        && exists(/databases/$(database)/documents/families/$(parent.data.familyCode)/members/$(kidUid));
    }

    function isMemberOf(code, kidUid) {
      return code is string && exists(/databases/$(database)/documents/families/$(code)/members/$(kidUid));
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isParentOf(uid));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['kid', 'parent']
        && !exists(/databases/$(database)/documents/deleted/$(uid));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && (request.resource.data.get('familyCode', null) == resource.data.get('familyCode', null)
          || !isMemberOf(resource.data.get('familyCode', null), uid));
      allow delete: if (signedIn() && request.auth.uid == uid && resource.data.role == 'parent')
        || isParentOf(uid);

      match /progress/{activityId} {
        allow read: if signedIn() && (request.auth.uid == uid || isParentOf(uid));
        allow write: if signedIn() && request.auth.uid == uid;
        allow delete: if isParentOf(uid);
      }

      // Screen time per day: the child's devices add the seconds used (the
      // total can only go up); the parent, or a grown-up on the child's
      // device, adds extra minutes.
      match /usage/{day} {
        allow read: if signedIn() && (request.auth.uid == uid || isParentOf(uid));
        allow create: if signedIn() && (
          (request.auth.uid == uid && request.resource.data.keys().hasOnly(['seconds', 'extraMinutes', 'updatedAt']))
          || (isParentOf(uid) && request.resource.data.keys().hasOnly(['extraMinutes', 'updatedAt'])));
        allow update: if signedIn() && (
          (request.auth.uid == uid && request.resource.data.keys().hasOnly(['seconds', 'extraMinutes', 'updatedAt'])
            && request.resource.data.get('seconds', 0) >= resource.data.get('seconds', 0))
          || (isParentOf(uid) && onlyChanges(['extraMinutes', 'updatedAt'])));
        allow delete: if isParentOf(uid);
      }
    }

    // Accounts deleted by their parent.
    match /deleted/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if isParentOf(uid);
    }

    match /families/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.parentUid == request.auth.uid;
      allow update: if isFamilyParent(code) && request.resource.data.parentUid == resource.data.parentUid;
      allow delete: if isFamilyParent(code);

      match /private/{doc} {
        allow read: if isFamilyParent(code) || isMember(code);
        allow write: if isFamilyParent(code);
      }

      match /requests/{kidUid} {
        allow read: if isFamilyParent(code) || (signedIn() && request.auth.uid == kidUid);
        allow create: if signedIn() && request.auth.uid == kidUid
          && request.resource.data.status == 'pending'
          && get(/databases/$(database)/documents/users/$(kidUid)).data.familyCode == code;
        allow update: if isFamilyParent(code)
          || (signedIn() && request.auth.uid == kidUid && request.resource.data.status == 'pending');
        allow delete: if isFamilyParent(code) || (signedIn() && request.auth.uid == kidUid);
      }

      match /members/{kidUid} {
        allow read: if isFamilyParent(code) || isMember(code)
          || (signedIn() && request.auth.uid == kidUid);
        allow create: if isFamilyParent(code)
          && exists(/databases/$(database)/documents/families/$(code)/requests/$(kidUid));
        allow update: if isFamilyParent(code)
          || (signedIn() && request.auth.uid == kidUid && onlyChanges(['summary', 'username', 'avatar', 'updatedAt']));
        allow delete: if isFamilyParent(code);
      }
    }
  }
}
