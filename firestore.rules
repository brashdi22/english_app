rules_version = '2';

// Each family's data can only be read and written by that family's own
// signed-in account. Children's progress, PINs and the scoreboard all live
// under families/{familyId}, so no family can see another family's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == familyId;
    }
  }
}
